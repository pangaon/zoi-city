{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/entity?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/b/:slug",
      "destination": "/b/index.html"
    },
    {
      "source": "/l/:slug",
      "destination": "/l/index.html"
    }
  ]
}