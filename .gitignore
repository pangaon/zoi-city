# Local dependencies, caches and generated exports; evidence is deliberately
# visible until its fixture/archive review has been accepted.
**/node_modules/
**/.expo/
**/.cache/
**/.recovery/
**/.vercel/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
/coverage/
/test-results/
/playwright-report/
/dist/
/web-build/
/artifacts/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*

# Downloads belong outside the repository, not beside deployable pages.
/*.whl
/*.apk
/*.aab
/*.ipa
/*.tgz
/*.tar.gz

# Keep examples reviewable; never commit local credentials.
/.env
/.env.*
!/.env.example
!/.env.sample

# Local release credentials and generated simulator capture receipts.
/.private-credentials/
/mobile/restoration-evidence/
