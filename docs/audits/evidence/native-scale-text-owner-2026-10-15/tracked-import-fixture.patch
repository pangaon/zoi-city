abel={profile.followed?'Following · unfollow':'Follow member'} selected={profile.followed} disabled={busy} run={follow}/>:<Action label="Sign in to follow" run={signIn}/>):null}</View>{session&&!profile.mine?<View style={s.panel}><Text style={s.heading}>Your feed controls</Text><Action label="Mute this member" disabled={busy} run={()=>run(async()=>{communityFlag(await client.rpc('community_mute_set',{p_profile:id,p_muted:true}),id,'muted',true);if(current())setNotice('Member muted in your feeds and notifications. Manage muted accounts in your community settings.');})}/><Action label={confirm?'Confirm block member':'Block this member'} disabled={busy} run={()=>{if(!confirm){setConfirm(true);return;}run(async()=>{communityFlag(await client.rpc('community_block_set',{p_profile:id,p_blocked:true}),id,'blocked',true);if(current()){setProfile(null);setNotice('Member blocked in your authenticated views and interactions. Public posts remain accessible on the public internet.');}});}}/></View>:null}</>:!busy?<Text style={s.body}>This public profile is unavailable or has not been configured.</Text>:null}</ScrollView>;}
