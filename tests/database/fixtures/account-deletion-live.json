  "ensure_profile": {
    "signature": "zoi.ensure_profile()",
    "definition": "CREATE OR REPLACE FUNCTION zoi.ensure_profile()\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'zoi', 'public'\nAS $function$\nDECLARE me uuid;\nBEGIN\n  IF auth.uid() IS NULL THEN RETURN NULL; END IF;\n  SELECT id INTO me FROM zoi.user_profiles WHERE auth_user_id=auth.uid();\n  IF me IS NULL THEN\n    INSERT INTO zoi.user_profiles(id, auth_user_id) VALUES (gen_random_uuid(), auth.uid()) RETURNING id INTO me;\n  END IF;\n  RETURN me;\nEND;$function$\n",
    "definition_md5": "a6d10d22f2cda05e1d4260997273afc0",
    "security_definer": true,
    "proconfig": [
      "search_path=zoi, public"
    ],
    "acl": null
  }
}
