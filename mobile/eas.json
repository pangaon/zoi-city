{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "channel": "production"
    },
    "founder-testflight": {
      "extends": "testflight",
      "channel": "founder-testflight",
      "env": {
        "ZOI_IOS_FOUNDER_RELEASE": "1"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "1464901778"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "1464901778"
      }
    },
    "founder-testflight": {
      "ios": {
        "ascAppId": "6823485650"
      }
    }
  }
}
