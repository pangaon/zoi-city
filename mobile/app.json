{
  "expo": {
    "name": "Zoi",
    "slug": "zoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usgreekscan.zoi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.usgreekscan.zoi",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "59352b1c-50c5-4717-a22d-53188fa500c7"
      }
    },
    "scheme": "zoi",
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zoi to access the photos and videos you choose to share with the community.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
